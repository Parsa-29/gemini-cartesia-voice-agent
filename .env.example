# ── Server ───────────────────────────────────────────────────
PORT=4000
# Let the browser settings panel override prompt / greeting / voice / speed per call.
# Turn off when the server is reachable by people who shouldn't change the agent.
ALLOW_CLIENT_OVERRIDES=true

# ── Gemini Live (listens + thinks) ───────────────────────────
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Language of the user's speech for transcripts. Empty = same as CARTESIA_LANGUAGE; `auto` = detect.
GEMINI_INPUT_LANGUAGE=
# Silence (ms) before Gemini decides you finished speaking. Lower = snappier, higher = fewer cut-offs.
GEMINI_VAD_SILENCE_MS=600
# Optional VAD tuning: LOW or HIGH (leave empty for Gemini defaults).
GEMINI_VAD_START_SENSITIVITY=
GEMINI_VAD_END_SENSITIVITY=
GEMINI_VAD_PREFIX_PADDING_MS=

# ── Cartesia Sonic (speaks) ──────────────────────────────────
CARTESIA_API_KEY=
# A voice that speaks your language well — pick one at https://play.cartesia.ai/voices
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6
CARTESIA_LANGUAGE=ka
CARTESIA_SAMPLE_RATE=24000
# 0.6–1.5
CARTESIA_SPEED=1.0
# 0.5–2.0
CARTESIA_VOLUME=1.0
# Optional: pronunciation dictionary id for brand names / jargon.
CARTESIA_PRONUNCIATION_DICT_ID=
# How long Cartesia may hold text waiting for more context (0–5000 ms).
# 0 = speak each chunk immediately; the server already cuts text at good boundaries.
CARTESIA_MAX_BUFFER_DELAY_MS=0

# ── Turn-taking ──────────────────────────────────────────────
# Letters of new user speech (while the agent is audible) needed to cut the agent off.
BARGE_IN_MIN_CHARS=3
